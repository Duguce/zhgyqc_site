# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so

# Virtual environments
.venv/
venv/

# Build artifacts
build/
dist/

# Runtime outputs
outputs/*
!outputs/.gitkeep
release/*
!release/.gitkeep

# OS files
.DS_Store
._*
.AppleDouble/
Thumbs.db

# IDE/editor
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log

# Local configuration files
static/config/config.local.js
*.local.*
.env
.env.*
!.env.example
!.env.*.example

# Local editor, agent, and hosting settings
/.codex/
/.agents/
/.vercel/
/.netlify/

# Local dependency and tool caches
node_modules/
.cache/
.hugo_cache/
.hugo_build.lock

# Local scratch space: preview builds and screenshots
.audit/

# Hugo output: Actions rebuilds the site from source on every push and deploys
# that artefact, so the committed copy served no purpose.
public/

# Hugo generates responsive images and compiled resources during builds.
resources/_gen/
